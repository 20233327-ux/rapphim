{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "repository": {
    "type": "git",
    "url": "git@github.com:20233327-ux/rapphim.git"
  },
  "homepage": "https://github.com/20233327-ux/rapphim",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "api:dev": "node server/index.js",
    "start": "node server/index.js",
    "api:start": "node server/index.js",
    "build": "vite build",
    "build:prod": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "db:up": "docker compose --env-file .env.db -f docker-compose.db.yml up -d",
    "db:down": "docker compose --env-file .env.db -f docker-compose.db.yml down",
    "db:reset": "docker compose --env-file .env.db -f docker-compose.db.yml down -v",
    "db:logs": "docker compose --env-file .env.db -f docker-compose.db.yml logs -f postgres"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
